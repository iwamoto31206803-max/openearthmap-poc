def load_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def load_id_set(path):
    data = load_json(path)

    if isinstance(data, list):
        return set(str(x) for x in data)

    if isinstance(data, dict):
        for key in ("image_ids", "ids", "samples"):
            if key in data and isinstance(data[key], list):
                return set(str(x) for x in data[key])

    raise ValueError(f"Cannot interpret ID file structure: {path}")


def png_map(directory):
    result = {}

    for path in directory.rglob("*.png"):
        rel = path.relative_to(directory).with_suffix("").as_posix()
        result[rel] = path

    return result


def pad_to_stride32(rgb_tensor):
    h, w = rgb_tensor.shape[1:]
    target_h = ((h + 31) // 32) * 32
    target_w = ((w + 31) // 32) * 32

    padding = (0, target_w - w, 0, target_h - h)

    return F.pad(
        rgb_tensor,
        padding,
        mode="replicate",
    )


class Aggregate:
    def __init__(self):
        self.pixel_count = 0
        self.predicted = Counter()

        self.water_prob_sum = 0.0
        self.agri_prob_sum = 0.0

        self.water_argmax_count = 0
        self.agri_argmax_count = 0

    def add(self, probabilities, prediction):
        n = int(prediction.numel())

        self.pixel_count += n

        bincount = torch.bincount(
            prediction.reshape(-1).cpu(),
            minlength=9,
        )

        for cid in range(9):
            self.predicted[cid] += int(bincount[cid])

        self.water_argmax_count += int((prediction == 6).sum())
        self.agri_argmax_count += int((prediction == 7).sum())

        self.water_prob_sum += (
            probabilities[:, 6].double().sum().item()
        )

        self.agri_prob_sum += (
            probabilities[:, 7].double().sum().item()
        )

    def mean_water_prob(self):
        if not self.pixel_count:
            return math.nan
        return self.water_prob_sum / self.pixel_count

    def mean_agri_prob(self):
        if not self.pixel_count:
            return math.nan
        return self.agri_prob_sum / self.pixel_count

    def water_rate(self):
        if not self.pixel_count:
            return math.nan
        return self.water_argmax_count / self.pixel_count

    def agri_rate(self):
        if not self.pixel_count:
            return math.nan
        return self.agri_argmax_count / self.pixel_count


def print_aggregate(name, agg):
    print()
    print(f"[{name}]")
    print(f"pixels                    : {agg.pixel_count:,}")

    if agg.pixel_count == 0:
        return

    print(
        f"Base argmax Water         : "
        f"{agg.water_argmax_count:,} "
        f"({100 * agg.water_rate():.4f}%)"
    )

    print(
        f"Base argmax Agriculture   : "
        f"{agg.agri_argmax_count:,} "
        f"({100 * agg.agri_rate():.4f}%)"
    )

    print(
        f"mean Base Water prob      : "
        f"{agg.mean_water_prob():.6f}"
    )

    print(
        f"mean Base Agriculture prob: "
        f"{agg.mean_agri_prob():.6f}"
    )

    print()
    print("Base top-1 class distribution")

    for cid in range(9):
        count = agg.predicted[cid]
        pct = 100 * count / agg.pixel_count

        print(
            f"  {cid}: {CLASS_NAMES[cid]:28s} "
            f"{count:12,d}  ({pct:7.3f}%)"
        )


