all_ignore_count = 0

start = time.time()


# ============================================================
# 4. Full dataset Base inference
# ============================================================

heading("3. FULL GSI PADDY DATASET BASE INFERENCE")

with torch.inference_mode():

    for index, image_id in enumerate(sorted(images), start=1):

        image_path = images[image_id]
        label_path = labels[image_id]

        with Image.open(image_path) as img:
            rgb = np.asarray(
                img.convert("RGB"),
                dtype=np.uint8,
            )

        label_np = read_label(label_path)

        if rgb.shape[:2] != label_np.shape:
            raise ValueError("RGB / label shape mismatch")

        h, w = label_np.shape

        tensor = rgb_to_tensor(rgb)
        tensor = pad_to_stride32(tensor)
        tensor = tensor.unsqueeze(0).to(DEVICE)

        logits = model(tensor)

        # Remove synthetic right/bottom padding.
        logits = logits[:, :, :h, :w]

        probabilities = logits.softmax(1)
        prediction = logits.argmax(1)

        label = torch.from_numpy(
            label_np.astype(np.int64)
        ).unsqueeze(0)

        positive = label == TARGET_CLASS
        unknown = label == IGNORE_INDEX

        positive_count = int(positive.sum())

        # ----------------------------------------------------
        # Positive-bearing image
        # ----------------------------------------------------

        if positive_count > 0:

            usable_count += 1
            positive_images += 1

            p_probs = probabilities.permute(
                0, 2, 3, 1
            )[positive]

            p_pred = prediction[positive]

            # convert Nx9 -> 1x9xN style expected by Aggregate.add
            p_probs_for_agg = p_probs.T.unsqueeze(0)
            p_pred_for_agg = p_pred.unsqueeze(0)

            positive_all.add(
                p_probs_for_agg,
                p_pred_for_agg,
            )

            if image_id in train_ids:
                positive_train.add(
                    p_probs_for_agg,
                    p_pred_for_agg,
                )

            elif image_id in validation_ids:
                positive_validation.add(
                    p_probs_for_agg,
                    p_pred_for_agg,
                )

            else:
                raise ValueError(
                    "Positive-bearing image is in neither "
                    "train nor validation split"
                )

            water_on_positive = int(
                (p_pred == 6).sum()
            )

            positive_water_pixels_per_image.append(
                water_on_positive
            )

            if water_on_positive > 0:
                positive_images_with_base_water += 1

            # Real unknown pixels inside positive-bearing images
            u_probs = probabilities.permute(
                0, 2, 3, 1
            )[unknown]

            u_pred = prediction[unknown]

            unknown_positive_images.add(
                u_probs.T.unsqueeze(0),
                u_pred.unsqueeze(0),
            )

        # ----------------------------------------------------
        # All-ignore / FALSE image
        # ----------------------------------------------------

        else:

            all_ignore_count += 1

            if not bool(unknown.all()):
                raise ValueError(
                    "Image has no positive pixels but is not all-ignore"
                )

            probs_flat = probabilities.reshape(
                1, 9, -1
            )

            pred_flat = prediction.reshape(
                1, -1
            )

            all_ignore.add(
                probs_flat,
                pred_flat,
            )

        if index % 50 == 0 or index == len(images):

            elapsed = time.time() - start

            print(
                f"processed {index}/{len(images)} "
                f"| positive-images={usable_count} "
                f"| all-ignore={all_ignore_count} "
                f"| elapsed={elapsed / 60:.1f} min",
                flush=True,
            )


