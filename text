from pathlib import Path
from collections import Counter, defaultdict
import csv
import math


# ============================================================
# OpenEarthMap Phase A
# Water degradation diagnosis from EXISTING SACLAJ results only
#
# IMPORTANT:
# - READ ONLY
# - No new model inference
# - No network access
# - No training
# - No SACLAJ IDs / coordinates / site-level rows are printed
# ============================================================


ROOT = Path(r"C:\OpenEarthMap_PoC")

V01_EVAL = (
    ROOT
    / "data"
    / "saclaj"
    / "results"
    / "20260916T100521_996447Z_ad671432"
)

V02_EVAL = (
    ROOT
    / "data"
    / "saclaj"
    / "results"
    / "20260916T135520_362028Z_4a047f8d"
)

V01_CSV = V01_EVAL / "site_results.csv"
V02_CSV = V02_EVAL / "site_results.csv"


CLASS_NAMES = {
    0: "Background / Unlabelled",
    1: "Bareland",
    2: "Grass / Rangeland",
    3: "Pavement / Developed space",
    4: "Road",
    5: "Tree",
    6: "Water",
    7: "Cropland / Agriculture",
    8: "Buildings",
}


def heading(text):
    print()
    print("=" * 76)
    print(text)
    print("=" * 76)


def load_rows(path: Path):
    if not path.exists():
        raise FileNotFoundError(path)

    with path.open("r", encoding="utf-8-sig", newline="") as f:
        return list(csv.DictReader(f))


def site_key(row):
    # Sensitive values used ONLY locally for exact pairing.
    # Never printed.
    return (
        row.get("ID", ""),
        row.get("Latitude", ""),
        row.get("Longitude", ""),
        row.get("Category_ID", ""),
        row.get("subtype", ""),
        row.get("expected_class", ""),
    )


def success_map(rows):
    return {
        site_key(r): r
        for r in rows
        if r.get("status") == "success"
    }


def to_int(value):
    return int(float(value))


def to_float(value):
    if value in (None, ""):
        return math.nan
    return float(value)


def fmt_prob(value):
    if math.isnan(value):
        return "N/A"
    return f"{value:.4f}"


def mean(values):
    values = [v for v in values if not math.isnan(v)]
    if not values:
        return math.nan
    return sum(values) / len(values)


def class_name(class_id):
    return CLASS_NAMES.get(class_id, f"Unknown class {class_id}")


# ============================================================
# 0. Load / pair
# ============================================================

heading("0. LOAD EXISTING SACLAJ RESULTS")

rows1 = load_rows(V01_CSV)
rows2 = load_rows(V02_CSV)

m1 = success_map(rows1)
m2 = success_map(rows2)

common = set(m1) & set(m2)

print(f"v0.1 successful rows     : {len(m1)}")
print(f"v0.2 successful rows     : {len(m2)}")
print(f"common successful rows   : {len(common)}")

if len(common) != 1000:
    print("WARNING: expected 1000 common successful sites.")


# ============================================================
# 1. Select Water reference points
# ============================================================

heading("1. WATER REFERENCE SUBSET")

water_keys = [
    key
    for key in common
    if m2[key].get("subtype") == "water"
    and to_int(m2[key].get("expected_class", "-1")) == 6
]

print(f"Water reference sites    : {len(water_keys)}")

if len(water_keys) != 100:
    print("WARNING: expected 100 Water reference sites.")


# ============================================================
# 2. Sanity: Base predictions must match across evaluation runs
# ============================================================

heading("2. BASE PREDICTION IDENTITY ACROSS v0.1 / v0.2 EVALUATION RUNS")

base_prediction_mismatch = 0
base_expected_prob_diffs = []
base_agri_prob_diffs = []

for key in water_keys:
    a = m1[key]
    b = m2[key]

    pred1 = to_int(a["base_predicted_class"])
    pred2 = to_int(b["base_predicted_class"])

    if pred1 != pred2:
        base_prediction_mismatch += 1

    p1 = to_float(a["base_expected_probability"])
    p2 = to_float(b["base_expected_probability"])
    a1 = to_float(a["base_agriculture_probability"])
    a2 = to_float(b["base_agriculture_probability"])

    base_expected_prob_diffs.append(abs(p1 - p2))
    base_agri_prob_diffs.append(abs(a1 - a2))

print(f"Base argmax mismatches   : {base_prediction_mismatch}")
print(
    "max |Base Water prob diff| : "
    f"{max(base_expected_prob_diffs) if base_expected_prob_diffs else math.nan:.12g}"
)
print(
    "max |Base Agri prob diff|  : "
    f"{max(base_agri_prob_diffs) if base_agri_prob_diffs else math.nan:.12g}"
)

base_identity_pass = (
    base_prediction_mismatch == 0
    and max(base_expected_prob_diffs, default=0) < 1e-12
    and max(base_agri_prob_diffs, default=0) < 1e-12
)

print(f"Base inference identity  : {'PASS' if base_identity_pass else 'FAIL'}")


# ============================================================
# 3. Overall predictions on Water reference points
# ============================================================

heading("3. WATER REFERENCE: TOP-1 PREDICTION DISTRIBUTION")

base_counts = Counter()
v01_counts = Counter()
v02_counts = Counter()

for key in water_keys:
    r1 = m1[key]
    r2 = m2[key]

    base_counts[to_int(r2["base_predicted_class"])] += 1
    v01_counts[to_int(r1["fine_tuned_predicted_class"])] += 1
    v02_counts[to_int(r2["fine_tuned_predicted_class"])] += 1


print("Class                         Base   v0.1   v0.2")
print("-" * 55)

for cid in range(9):
    print(
        f"{cid}: {class_name(cid):28s} "
        f"{base_counts[cid]:4d}   {v01_counts[cid]:4d}   {v02_counts[cid]:4d}"
    )

print()
print(f"Base Water agreement     : {base_counts[6]} / {len(water_keys)}")
print(f"v0.1 Water agreement     : {v01_counts[6]} / {len(water_keys)}")
print(f"v0.2 Water agreement     : {v02_counts[6]} / {len(water_keys)}")


# ============================================================
# 4. Base -> v0.2 paired transition
# ============================================================

heading("4. PAIRED TRANSITION: BASE -> v0.2 ON WATER REFERENCE")

transition = Counter()

for key in water_keys:
    r = m2[key]

    base_pred = to_int(r["base_predicted_class"])
    v02_pred = to_int(r["fine_tuned_predicted_class"])

    transition[(base_pred, v02_pred)] += 1


print("From Base                     -> To v0.2                     Count")
print("-" * 72)

for (src, dst), count in sorted(
    transition.items(),
    key=lambda x: (-x[1], x[0][0], x[0][1]),
):
    print(
        f"{src}: {class_name(src):27s} -> "
        f"{dst}: {class_name(dst):27s} {count:3d}"
    )


# ============================================================
# 5. Focus: Base-correct Water -> v0.2
# ============================================================

heading("5. BASE-CORRECT WATER SITES: WHERE DID v0.2 MOVE?")

base_correct_keys = [
    key
    for key in water_keys
    if to_int(m2[key]["base_predicted_class"]) == 6
]

print(f"Base-correct Water sites : {len(base_correct_keys)}")

destination = Counter(
    to_int(m2[key]["fine_tuned_predicted_class"])
    for key in base_correct_keys
)

for cid, count in sorted(destination.items(), key=lambda x: (-x[1], x[0])):
    pct = 100 * count / len(base_correct_keys) if base_correct_keys else 0

    print(
        f"{cid}: {class_name(cid):28s} "
        f"{count:3d}  ({pct:5.1f}%)"
    )


retained = destination[6]
lost = len(base_correct_keys) - retained

print()
print(f"Water retained           : {retained}")
print(f"Water lost               : {lost}")

if base_correct_keys:
    print(
        f"Water retention rate     : "
        f"{100 * retained / len(base_correct_keys):.1f}%"
    )


# ============================================================
# 6. Was Water mainly absorbed by Agriculture?
# ============================================================

heading("6. BASE-CORRECT WATER LOSS: AGRICULTURE VS OTHER CLASSES")

water_to_agri = 0
water_to_other = 0

for key in base_correct_keys:
    dst = to_int(m2[key]["fine_tuned_predicted_class"])

    if dst == 6:
        continue
    elif dst == 7:
        water_to_agri += 1
    else:
        water_to_other += 1


print(f"Base Water -> Agriculture: {water_to_agri}")
print(f"Base Water -> other class: {water_to_other}")

if lost:
    print(
        f"Agriculture share of Water loss: "
        f"{100 * water_to_agri / lost:.1f}%"
    )


# ============================================================
# 7. Probability shifts on ALL Water reference points
# ============================================================

heading("7. PROBABILITY SHIFT: ALL WATER REFERENCE SITES")

base_water_probs = []
v01_water_probs = []
v02_water_probs = []

base_agri_probs = []
v01_agri_probs = []
v02_agri_probs = []

for key in water_keys:
    r1 = m1[key]
    r2 = m2[key]

    base_water_probs.append(to_float(r2["base_expected_probability"]))
    v01_water_probs.append(to_float(r1["fine_tuned_expected_probability"]))
    v02_water_probs.append(to_float(r2["fine_tuned_expected_probability"]))

    base_agri_probs.append(to_float(r2["base_agriculture_probability"]))
    v01_agri_probs.append(to_float(r1["fine_tuned_agriculture_probability"]))
    v02_agri_probs.append(to_float(r2["fine_tuned_agriculture_probability"]))


print("Mean Water probability")
print(f"  Base : {fmt_prob(mean(base_water_probs))}")
print(f"  v0.1 : {fmt_prob(mean(v01_water_probs))}")
print(f"  v0.2 : {fmt_prob(mean(v02_water_probs))}")

print()
print("Mean Agriculture probability")
print(f"  Base : {fmt_prob(mean(base_agri_probs))}")
print(f"  v0.1 : {fmt_prob(mean(v01_agri_probs))}")
print(f"  v0.2 : {fmt_prob(mean(v02_agri_probs))}")


# ============================================================
# 8. Probability shifts only where Base was correct Water
# ============================================================

heading("8. PROBABILITY SHIFT: BASE-CORRECT WATER SITES ONLY")

bw = []
fw = []
ba = []
fa = []

for key in base_correct_keys:
    r = m2[key]

    bw.append(to_float(r["base_expected_probability"]))
    fw.append(to_float(r["fine_tuned_expected_probability"]))

    ba.append(to_float(r["base_agriculture_probability"]))
    fa.append(to_float(r["fine_tuned_agriculture_probability"]))


print(f"n                         : {len(base_correct_keys)}")
print(f"Base mean Water prob      : {fmt_prob(mean(bw))}")
print(f"v0.2 mean Water prob      : {fmt_prob(mean(fw))}")
print(f"mean Water prob delta     : {fmt_prob(mean(fw) - mean(bw))}")

print()
print(f"Base mean Agriculture prob: {fmt_prob(mean(ba))}")
print(f"v0.2 mean Agriculture prob: {fmt_prob(mean(fa))}")
print(f"mean Agriculture delta    : {fmt_prob(mean(fa) - mean(ba))}")


# ============================================================
# 9. Compare retained vs lost Base-Water sites
# ============================================================

heading("9. RETAINED WATER VS LOST WATER")

groups = {
    "retained_water": [],
    "lost_to_agriculture": [],
    "lost_to_other": [],
}

for key in base_correct_keys:
    r = m2[key]
    dst = to_int(r["fine_tuned_predicted_class"])

    if dst == 6:
        groups["retained_water"].append(r)
    elif dst == 7:
        groups["lost_to_agriculture"].append(r)
    else:
        groups["lost_to_other"].append(r)


for name, rows in groups.items():
    print()
    print(f"[{name}]")
    print(f"n                         : {len(rows)}")

    if not rows:
        continue

    b_water = [to_float(r["base_expected_probability"]) for r in rows]
    f_water = [to_float(r["fine_tuned_expected_probability"]) for r in rows]

    b_agri = [to_float(r["base_agriculture_probability"]) for r in rows]
    f_agri = [to_float(r["fine_tuned_agriculture_probability"]) for r in rows]

    print(f"Base Water prob           : {fmt_prob(mean(b_water))}")
    print(f"v0.2 Water prob           : {fmt_prob(mean(f_water))}")
    print(f"Base Agriculture prob     : {fmt_prob(mean(b_agri))}")
    print(f"v0.2 Agriculture prob     : {fmt_prob(mean(f_agri))}")


# ============================================================
# 10. v0.1 -> v0.2 recovery pattern
# ============================================================

heading("10. v0.1 -> v0.2 RECOVERY ON WATER REFERENCE")

recovery = Counter()

for key in water_keys:
    r1 = m1[key]
    r2 = m2[key]

    v01_pred = to_int(r1["fine_tuned_predicted_class"])
    v02_pred = to_int(r2["fine_tuned_predicted_class"])

    recovery[(v01_pred, v02_pred)] += 1


print("From v0.1                     -> To v0.2                     Count")
print("-" * 72)

for (src, dst), count in sorted(
    recovery.items(),
    key=lambda x: (-x[1], x[0][0], x[0][1]),
):
    print(
        f"{src}: {class_name(src):27s} -> "
        f"{dst}: {class_name(dst):27s} {count:3d}"
    )


# ============================================================
# 11. Simple diagnosis flags
# ============================================================

heading("11. WATER DIAGNOSIS SUMMARY")

if lost == 0:
    agri_loss_share = 0.0
else:
    agri_loss_share = water_to_agri / lost


print(f"Base Water-correct sites      : {len(base_correct_keys)}")
print(f"Retained as Water in v0.2     : {retained}")
print(f"Lost from Water in v0.2       : {lost}")
print(f"Lost specifically to Agri     : {water_to_agri}")
print(f"Lost to other classes         : {water_to_other}")
print(f"Agri share of Water loss      : {100 * agri_loss_share:.1f}%")

print()

if agri_loss_share >= 0.70:
    print(
        "PATTERN: Strongly concentrated Water -> Agriculture transition."
    )
    print(
        "Interpretation candidate: Agriculture adaptation directly competes "
        "with the Base Water decision on many sites."
    )
elif agri_loss_share >= 0.40:
    print(
        "PATTERN: Water loss is partly concentrated toward Agriculture, "
        "but substantial loss also goes to other classes."
    )
    print(
        "Interpretation candidate: class-7 pressure is important but may not "
        "fully explain the degradation."
    )
else:
    print(
        "PATTERN: Water loss is broadly distributed across classes rather than "
        "mainly Water -> Agriculture."
    )
    print(
        "Interpretation candidate: investigate wider decoder / representation "
        "drift, including BatchNorm behavior, before assuming class-7 conflict."
    )

print()
print(
    "This is a descriptive diagnosis from the existing development evaluation, "
    "not a causal proof."
)

print(
    "No SACLAJ IDs, coordinates, patch names, or site-level predictions "
    "were printed."
)
