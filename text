def check_exists(name, path):
    ok = path.exists()
    print(f"{name:30s}: {boolstr(ok)}")
    if not ok:
        print(f"  missing path: {path}")
    return ok


def manifest_summary(name, run_dir, manifest_name="run_manifest.json"):
    path = run_dir / manifest_name
    data = load_json(path)

    print()
    print(f"[{name}]")

    if data is None:
        print("manifest: MISSING")
        return None

    print(f"run_id              : {data.get('run_id', 'NOT RECORDED')}")
    print(f"status              : {data.get('status', 'NOT RECORDED')}")
    print(f"training_mode       : {data.get('training_mode', 'N/A')}")
    print(f"seed                : {data.get('seed', data.get('sampling_seed', 'N/A'))}")
    print(f"train_count         : {data.get('train_count', 'N/A')}")
    print(f"validation_count    : {data.get('validation_count', 'N/A')}")
    print(f"excluded_all_ignore : {data.get('excluded_all_ignore_images', 'N/A')}")

    base_hash = (
        data.get("base_model_sha256")
        or data.get("base_checkpoint_sha256")
    )
    print(f"Base SHA256         : {short_hash(base_hash)}")

    return data


def file_hash_compare(label, p1, p2):
    h1 = sha256(p1)
    h2 = sha256(p2)
    ok = h1 is not None and h2 is not None and h1 == h2
    print(f"{label:30s}: {boolstr(ok)}")
    print(f"  v0.1: {short_hash(h1)}")
    print(f"  v0.2: {short_hash(h2)}")
    return ok


def load_site_rows(path: Path):
    rows = []
    if not path.exists():
        return rows

    with path.open("r", encoding="utf-8-sig", newline="") as f:
        for row in csv.DictReader(f):
            rows.append(row)
    return rows


def site_key(row):
    # Sensitive fields are used ONLY locally for exact pairing.
    # They are never printed.
    return (
        row.get("ID", ""),
        row.get("Latitude", ""),
        row.get("Longitude", ""),
        row.get("Category_ID", ""),
        row.get("subtype", ""),
        row.get("expected_class", ""),
    )


def successful_map(rows):
    result = {}
    for row in rows:
        if row.get("status") == "success":
            result[site_key(row)] = row
    return result


def all_site_keys(rows):
    return {site_key(r) for r in rows}


