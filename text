    )

else:

    print(
        "PATTERN: MOST IMAGES HAVE RELATIVELY LOW IMAGE-LEVEL CONFLICT."
    )

    print(
        "The overall 21% pixel-level conflict may be concentrated in large "
        "positive regions or specific scene structures."
    )


print()

print(
    "This remains descriptive evidence. "
    "Base-Water prediction does not establish true Water ground truth."
)
